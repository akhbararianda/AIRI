#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDI_AIRI ICON "airi.ico"

1 VERSIONINFO
FILEVERSION 2,8,0,0
PRODUCTVERSION 2,8,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "AIRI Technology\0"
      VALUE "FileDescription", "AIRI Download Manager Pro Download Center\0"
      VALUE "FileVersion", "2.8.0\0"
      VALUE "InternalName", "AIRI Download Manager\0"
      VALUE "LegalCopyright", "© 2026 AIRI Technology. Founder: Akhbar Arianda\0"
      VALUE "OriginalFilename", "AIRI Download Manager.exe\0"
      VALUE "ProductName", "AIRI Download Manager\0"
      VALUE "ProductVersion", "2.8.0 Pro Download Center\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_ADD_URL DIALOGEX 0,0,420,198
STYLE DS_SETFONT|DS_MODALFRAME|WS_POPUP|WS_CAPTION|WS_SYSMENU
CAPTION "AIRI - New Download"
FONT 10,"Segoe UI"
BEGIN
LTEXT "Download URL",-1,16,16,380,11
EDITTEXT IDC_URL,16,31,388,24,ES_AUTOHSCROLL|WS_TABSTOP
LTEXT "Filename (optional)",-1,16,66,170,11
EDITTEXT IDC_FILENAME,16,81,388,24,ES_AUTOHSCROLL|WS_TABSTOP
LTEXT "Turbo connections",-1,16,118,100,11
COMBOBOX IDC_CONNECTIONS,118,115,90,100,CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
LTEXT "AIRI automatically supports ordinary HTTP/HTTPS file types.",-1,16,143,300,10
PUSHBUTTON "Cancel",IDCANCEL,264,164,64,24
DEFPUSHBUTTON "Start download",IDOK,334,164,70,24
END

IDD_LICENSE DIALOGEX 0,0,430,236
STYLE DS_SETFONT|DS_MODALFRAME|WS_POPUP|WS_CAPTION|WS_SYSMENU
CAPTION "AIRI License & Trial"
FONT 10,"Segoe UI"
BEGIN
LTEXT "AIRI Download Manager Commercial Edition",-1,16,14,300,12
LTEXT "Developed by AIRI Technology - Founder Akhbar Arianda",-1,16,30,350,10
LTEXT "License status",-1,16,53,90,10
LTEXT "-",IDC_LICENSE_STATUS,112,53,292,20
LTEXT "Machine ID",-1,16,80,90,10
EDITTEXT IDC_MACHINE_ID,16,94,398,22,ES_AUTOHSCROLL|ES_READONLY
LTEXT "License key",-1,16,126,90,10
EDITTEXT IDC_LICENSE_KEY,16,140,398,54,ES_MULTILINE|ES_AUTOVSCROLL|WS_VSCROLL|WS_TABSTOP
PUSHBUTTON "Close",IDCANCEL,278,204,64,24
DEFPUSHBUTTON "Activate",IDOK,348,204,66,24
END

IDD_SCHEDULER DIALOGEX 0,0,350,178
STYLE DS_SETFONT|DS_MODALFRAME|WS_POPUP|WS_CAPTION|WS_SYSMENU
CAPTION "AIRI Scheduler"
FONT 10,"Segoe UI"
BEGIN
LTEXT "Queue action",-1,16,17,100,11
COMBOBOX IDC_SCHED_ACTION,16,33,170,90,CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
LTEXT "Run after",-1,16,72,80,11
EDITTEXT IDC_SCHED_MINUTES,16,88,86,23,ES_NUMBER|ES_AUTOHSCROLL|WS_TABSTOP
LTEXT "minutes",-1,108,93,55,11
LTEXT "The scheduler stays active while AIRI is running.",-1,16,122,280,11
PUSHBUTTON "Cancel",IDCANCEL,205,141,60,24
DEFPUSHBUTTON "Schedule",IDOK,272,141,62,24
END

IDD_OPTIONS DIALOGEX 0,0,380,210
STYLE DS_SETFONT|DS_MODALFRAME|WS_POPUP|WS_CAPTION|WS_SYSMENU
CAPTION "AIRI Options"
FONT 10,"Segoe UI"
BEGIN
LTEXT "Default Turbo connections",-1,16,18,150,11
COMBOBOX IDC_OPT_CONNECTIONS,180,15,90,100,CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
CONTROL "Start direct downloads immediately",IDC_OPT_AUTOSTART,"Button",BS_AUTOCHECKBOX|WS_TABSTOP,16,58,220,14
CONTROL "Keep completed and failed download history",IDC_OPT_NOTIFY,"Button",BS_AUTOCHECKBOX|WS_TABSTOP,16,82,250,14
LTEXT "Recommended: 8-16 connections. AIRI automatically caps large files when needed.",-1,16,112,340,25
LTEXT "Settings are saved per Windows user.",-1,16,143,250,11
PUSHBUTTON "Cancel",IDCANCEL,234,173,60,24
DEFPUSHBUTTON "Save",IDOK,302,173,60,24
END
