#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDI_AIRI ICON "airi.ico"

1 VERSIONINFO
FILEVERSION 2,6,1,0
PRODUCTVERSION 2,6,1,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "AIRI Technology\0"
      VALUE "FileDescription", "AIRI Download Manager\0"
      VALUE "FileVersion", "2.6.1\0"
      VALUE "InternalName", "AIRI Download Manager\0"
      VALUE "LegalCopyright", "© 2026 AIRI Technology. Founder: Akhbar Arianda\0"
      VALUE "OriginalFilename", "AIRI Download Manager.exe\0"
      VALUE "ProductName", "AIRI Download Manager\0"
      VALUE "ProductVersion", "2.6.1 AIRI Edition\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_ADD_URL DIALOGEX 0,0,400,190
STYLE DS_SETFONT|DS_MODALFRAME|WS_POPUP|WS_CAPTION|WS_SYSMENU
CAPTION "AIRI • New Download"
FONT 10,"Segoe UI"
BEGIN
LTEXT "Download URL",-1,16,16,360,11
EDITTEXT IDC_URL,16,31,368,24,ES_AUTOHSCROLL|WS_TABSTOP
LTEXT "Filename (optional)",-1,16,66,170,11
EDITTEXT IDC_FILENAME,16,81,368,24,ES_AUTOHSCROLL|WS_TABSTOP
LTEXT "Turbo connections",-1,16,118,100,11
COMBOBOX IDC_CONNECTIONS,118,115,78,100,CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
LTEXT "AIRI automatically supports any normal HTTP/HTTPS file type.",-1,16,143,250,10
PUSHBUTTON "Cancel",IDCANCEL,246,156,64,24
DEFPUSHBUTTON "Start download",IDOK,316,156,68,24
END

IDD_LICENSE DIALOGEX 0,0,430,236
STYLE DS_SETFONT|DS_MODALFRAME|WS_POPUP|WS_CAPTION|WS_SYSMENU
CAPTION "AIRI License & Trial"
FONT 10,"Segoe UI"
BEGIN
LTEXT "AIRI Download Manager Commercial Edition",-1,16,14,300,12
LTEXT "Developed by AIRI Technology • Founder Akhbar Arianda",-1,16,30,350,10
LTEXT "License status",-1,16,53,90,10
LTEXT "-",IDC_LICENSE_STATUS,112,53,292,20
LTEXT "Machine ID",-1,16,80,90,10
EDITTEXT IDC_MACHINE_ID,16,94,398,22,ES_AUTOHSCROLL|ES_READONLY
LTEXT "License key",-1,16,126,90,10
EDITTEXT IDC_LICENSE_KEY,16,140,398,54,ES_MULTILINE|ES_AUTOVSCROLL|WS_VSCROLL|WS_TABSTOP
PUSHBUTTON "Close",IDCANCEL,278,204,64,24
DEFPUSHBUTTON "Activate",IDOK,348,204,66,24
END
