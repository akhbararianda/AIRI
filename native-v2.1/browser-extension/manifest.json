{
  "manifest_version": 3,
  "name": "AIRI Download Manager Integration",
  "version": "3.2.0",
  "description": "Native Windows integration for AIRI Download Manager v2.2 Turbo.",
  "permissions": ["downloads", "nativeMessaging", "storage", "contextMenus", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "service-worker.js"},
  "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["youtube-overlay.js"], "css": ["youtube-overlay.css"], "run_at": "document_idle"}],
  "action": {
    "default_title": "AIRI Download Manager",
    "default_popup": "popup.html",
    "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}
  },
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "key": ""
}
